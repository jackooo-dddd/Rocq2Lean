#!/usr/bin/env bash
# M5/M6 environment (architectural decision, docs/ENVIRONMENT_M5.md): a dedicated opam switch
# `rocq930-mc` with the SAME pinned toolchain as rocq930 — Rocq 9.3.0 (rocq-core/runtime pinned),
# rocq-stdlib 9.2.0, coq-ext-lib 0.13.2, Equations d56dfc2c, MetaRocq c18395ad (utils, common,
# template) — built with dune pinned to 3.23.1, plus MathComp 2.6.0 (boot, order, ssreflect,
# fingroup, algebra) with Hierarchy Builder / rocq-elpi through opam. dune 3.23.1 is required
# because rocq-elpi 3.5.1 (needed by Hierarchy Builder, needed by MathComp 2.x) uses the
# `(using coq 0.8)` dune extension removed in dune 3.24; installing it into rocq930 would make opam
# downgrade dune and remove the pinned MetaRocq/Equations frontend. rocq930 is left unchanged.
set -euxo pipefail
export PATH=$HOME/.local/bin:$PATH
SW=rocq930-mc
EQ=d56dfc2c38feb5054d75ef43540ee89a6beb1a7e
MR=c18395ad772a40d59b6d04a5fcd1a4e0e5073d81
IGN=rocq-core,rocq-stdlib,rocq-runtime,coq-core,rocq-equations,coq-ext-lib
opam switch list --short | grep -qx "$SW" || \
  opam switch create "$SW" ocaml-base-compiler.4.14.2 --repos=default,rocq-released,core-dev --no-switch
opam pin add --switch=$SW -y -n dune 3.23.1
opam install --switch=$SW -y dune.3.23.1
opam install --switch=$SW -y rocq-runtime.9.3.0 rocq-core.9.3.0 rocq-stdlib.9.2.0
opam pin add --switch=$SW -y -n rocq-core 9.3.0
opam pin add --switch=$SW -y -n rocq-runtime 9.3.0
opam install --switch=$SW -y coq-ext-lib.0.13.2
opam pin add --switch=$SW -y -n -k git rocq-equations "git+https://github.com/mattam82/Coq-Equations.git#$EQ"
opam install --switch=$SW -y --ignore-constraints-on=$IGN rocq-equations
for p in utils common template; do
  opam pin add --switch=$SW -y -n -k git rocq-metarocq-$p "git+https://github.com/MetaRocq/metarocq.git#$MR"
done
opam install --switch=$SW -y --ignore-constraints-on=$IGN,rocq-metarocq-utils,rocq-metarocq-common rocq-metarocq-template
opam install --switch=$SW -y --ignore-constraints-on=$IGN,rocq-metarocq-utils,rocq-metarocq-common,rocq-metarocq-template \
  rocq-mathcomp-ssreflect.2.6.0
# M6 (Prosa v0.6 needs MathComp algebra and mathcomp-zify): install-only additions.
opam install --switch=$SW -y --ignore-constraints-on=$IGN,rocq-metarocq-utils,rocq-metarocq-common,rocq-metarocq-template \
  rocq-mathcomp-algebra.2.6.0 rocq-mathcomp-finite-group.2.6.0 rocq-micromega-plugin.1.1.1 rocq-mathcomp-zify.1.7.0+2.4+9.0
opam list --switch=$SW --installed --columns=name,version --short
echo SETUP_SWITCH_MC_DONE
